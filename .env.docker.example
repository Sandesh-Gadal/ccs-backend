# Copy to .env.docker and fill in the secrets: cp .env.docker.example .env.docker
APP_NAME="Chitwan Computer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# MySQL container from the deadbody_mapping project (same Docker network)
DB_CONNECTION=mysql
DB_HOST=deadbody_mapping-db-1
DB_PORT=3306
DB_DATABASE=ccsithub
DB_USERNAME=ccsithub
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Run `php artisan migrate --force` on container start
RUN_MIGRATIONS=true

# Admin panel login, created by `php artisan db:seed`
ADMIN_EMAIL=chitwancomputer@gmail.com
ADMIN_PASSWORD=
